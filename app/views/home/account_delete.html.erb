<div style="max-width:560px;margin:0 auto;padding:10px 8px 20px;color:#102847;font-size:14px;line-height:1.55;">
  <h1 style="font-size:24px;margin:0 0 16px;">アカウント削除</h1>

  <% if flash[:alert].present? %>
    <p role="alert" style="margin:0 0 10px;color:#b42318;font-size:13px;"><%= flash[:alert] %></p>
  <% end %>

  <p style="margin:0 0 8px;font-weight:700;">次のデータを削除します。</p>

  <ul style="margin:0 0 12px;padding-left:22px;line-height:1.65;">
    <li>登録情報・解答数・スタンプ取得履歴</li>
    <li>この端末の苦手問題・直近の解答データ</li>
  </ul>

  <div style="margin-bottom:12px;padding:10px 12px;border-radius:8px;background:#eef3f9;color:#4b5f78;font-size:12px;line-height:1.55;">
    <p style="margin:0 0 4px;">※ 別の端末の学習データと、ダウンロード済みPDFは削除されません。</p>
    <p style="margin:0;">※ Apple・Googleのアカウント自体や購入履歴は削除されず、返金も行われません。</p>
  </div>

  <% if current_user.provider == "apple" %>
    <p style="margin:0 0 12px;font-size:13px;">
      削除前にAppleで本人確認を行い、このアプリとの連携を解除します。
    </p>
  <% end %>

  <p style="margin:0 0 12px;color:#b42318;font-size:14px;font-weight:700;">
    この操作は取り消せません。
  </p>

  <%= form_with url: destroy_account_path, method: :delete, local: true,
        id: "account-deletion-form", data: { turbo: false, provider: current_user.provider } do %>
    <label style="display:flex;align-items:flex-start;gap:8px;margin-bottom:14px;font-size:13px;line-height:1.45;">
      <%= check_box_tag :confirm_deletion, "1", false, required: true,
            style: "width:18px;height:18px;margin:0;flex:0 0 auto;" %>
      <span>削除内容を確認しました。アカウントを削除します。</span>
    </label>

    <%= hidden_field_tag :apple_id_token %>
    <%= hidden_field_tag :apple_authorization_code %>

    <button type="submit" style="width:100%;padding:12px;border:none;border-radius:10px;background:#c62828;color:white;font-size:15px;font-weight:700;cursor:pointer;">
      アカウントを削除する
    </button>

    <p id="account-deletion-error" role="alert" style="margin:8px 0 0;color:#b42318;font-size:12px;"></p>
  <% end %>

  <div style="margin-top:14px;text-align:center;">
    <%= link_to "TOPに戻る", home_path,
          style: "color:#102847;font-size:14px;text-decoration:none;font-weight:700;" %>
  </div>
</div>
