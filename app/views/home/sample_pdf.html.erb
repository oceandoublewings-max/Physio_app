<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; min-height: 100%; background: #111820; }
  .sample-viewer { width: 100%; max-width: 760px; min-height: 100vh; margin: 0 auto; background: #111820; }
  .sample-viewer-header { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; justify-content: space-between; min-height: 54px; padding: 10px 16px; color: #fff; background: rgba(17, 24, 32, .94); border-bottom: 1px solid rgba(255,255,255,.12); backdrop-filter: blur(10px); }
  .sample-viewer-title { font-size: 15px; font-weight: 700; }
  .sample-viewer-count { color: rgba(255,255,255,.72); font-size: 12px; }
  .sample-pages { display: grid; gap: 14px; padding: 14px; }
  .sample-page { position: relative; overflow: hidden; background: #fff; box-shadow: 0 5px 18px rgba(0,0,0,.28); }
  .sample-page-number { position: absolute; top: 10px; left: 10px; z-index: 2; padding: 5px 10px; border-radius: 999px; color: #111820; background: rgba(255,255,255,.9); font-size: 12px; font-weight: 700; box-shadow: 0 2px 8px rgba(0,0,0,.12); }
  .sample-page img { display: block; width: 100%; height: auto; }
</style>

<div class="sample-viewer">
  <header class="sample-viewer-header">
    <span class="sample-viewer-title">サンプルを見る</span>
    <span class="sample-viewer-count"><%= @page_count %>ページ</span>
  </header>

  <main class="sample-pages">
    <% 1.upto(@page_count) do |page| %>
      <section class="sample-page">
        <span class="sample-page-number"><%= page %> / <%= @page_count %></span>
        <%= image_tag sample_pdf_page_path(kind: @sample_kind, page: page), alt: "サンプル #{page}ページ目" %>
      </section>
    <% end %>
  </main>
</div>
