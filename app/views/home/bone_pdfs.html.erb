<% bone_files = Dir.glob(Rails.root.join("public", "pdfs", "bone", "bone_*.pdf")).sort_by { |path| File.basename(path)[/\d+/].to_i } %>

<style>
  * { box-sizing: border-box; }
  body { margin:0; background:radial-gradient(circle at 50% 10%,rgba(42,92,145,.08),transparent 34%),linear-gradient(180deg,#f5f8fc 0%,#fff 48%,#f7f9fc 100%); color:#0c2340; }
  .bone-library-page{width:100%;max-width:430px;min-height:100vh;margin:0 auto;padding:18px 18px 30px}.bone-library-hero{position:relative;overflow:hidden;padding:24px 22px 22px;margin-bottom:24px;border-radius:0 0 30px 30px;background:linear-gradient(135deg,#071d3a 0%,#0b3765 58%,#39719e 100%);box-shadow:0 12px 30px rgba(7,29,58,.18)}.hero-top{position:relative;z-index:1;display:flex;align-items:center;gap:14px}.hero-icon{display:flex;align-items:center;justify-content:center;width:52px;height:52px;flex-shrink:0;border:2px solid #d7b75c;border-radius:15px;font-size:25px}.hero-title{margin:0;color:#fff;font-family:"Yu Mincho","Hiragino Mincho ProN",serif;font-size:20px;font-weight:700;white-space:nowrap}.hero-en{margin-top:5px;color:#d7b75c;font-size:10px;font-weight:700;letter-spacing:.2em}.hero-message{margin:17px 0 0;padding-top:14px;border-top:1px solid rgba(215,183,92,.35);color:rgba(255,255,255,.82);font-size:12px;line-height:1.7}.bone-library-heading{display:flex;align-items:center;justify-content:center;gap:11px;margin:0 0 18px;font-family:"Yu Mincho","Hiragino Mincho ProN",serif;font-size:20px;font-weight:700;color:#102b4c}.sample-card,.pdf-item{display:flex;align-items:center;background:#fff;color:#10233d;text-decoration:none;border:1px solid rgba(15,48,82,.10);box-shadow:0 5px 14px rgba(15,48,82,.06)}.sample-card{position:relative;width:100%;min-height:92px;padding:14px 48px 14px 16px;margin-bottom:14px;border-bottom:4px solid #d4b13e;border-radius:18px}.sample-icon{display:flex;align-items:center;justify-content:center;width:58px;height:58px;flex-shrink:0;margin-right:15px;border-radius:50%;font-size:27px;background:#f7efd0}.sample-name{display:block;font-size:19px;font-weight:700}.sample-en{display:block;margin-top:4px;color:#a98722;font-size:9px;font-weight:700}.purchase-card{padding:20px 18px;border-radius:20px;background:linear-gradient(135deg,#071d3a 0%,#0b3765 65%,#2e6593 100%);box-shadow:0 10px 24px rgba(7,29,58,.18)}.purchase-label{display:inline-block;padding:4px 10px;margin-bottom:11px;border:1px solid rgba(215,183,92,.55);border-radius:20px;color:#d7b75c;font-size:9px;font-weight:700}.purchase-title{display:flex;gap:10px;margin:0;color:#fff;font-size:20px}.purchase-text{margin:10px 0 0;color:rgba(255,255,255,.72);font-size:11px;line-height:1.7}.purchase-button{display:flex;align-items:center;justify-content:center;width:100%;min-height:48px;margin-top:16px;border:1px solid rgba(215,183,92,.75);border-radius:12px;background:#d7b75c;color:#071d3a;font-size:13px;font-weight:700}.purchase-status{margin-top:10px;color:rgba(255,255,255,.82);font-size:11px;text-align:center}.paid-library{display:none;margin-top:24px}.paid-library.is-unlocked{display:block}.library-note{margin:-8px 0 14px;color:#637286;font-size:11px;text-align:center}.pdf-list{display:grid;gap:10px}.pdf-item{justify-content:space-between;min-height:62px;padding:12px 14px;border-radius:14px}.pdf-item-left{display:flex;align-items:center;gap:11px}.pdf-icon{display:flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:10px;background:#f7efd0}.pdf-name{font-size:14px;font-weight:700}.pdf-download{color:#a98722;font-size:11px;font-weight:700}
</style>

<div class="bone-library-page">
  <section class="bone-library-hero"><div class="hero-top"><div class="hero-icon">🦴</div><div><h1 class="hero-title"><%= @pdf_product.title %></h1><div class="hero-en">BONE LIBRARY</div></div></div><p class="hero-message"><%= @pdf_product.description %></p></section>
  <div class="bone-library-heading">資料を見る</div>
  <a href="https://physio-app-4ahv.onrender.com/pdfs/bone/000bone_sample.pdf" class="sample-card pdf-open-link"><div class="sample-icon">📄</div><div><span class="sample-name">サンプルを見る</span><span class="sample-en">VIEW SAMPLE</span></div></a>
  <div class="purchase-card"><div class="purchase-label">BONE LIBRARY</div><h2 class="purchase-title"><span>🦴</span><span>骨 資料ライブラリ</span></h2><p class="purchase-text">一度ご購入いただくと、骨の資料を個別にダウンロードできます。<br>今後追加される骨の資料も追加料金なしでご利用いただけます。</p><button type="button" id="bone-purchase-button" class="purchase-button">購入情報を読み込み中…</button><div id="bone-purchase-status" class="purchase-status"></div></div>
  <section id="bone-paid-library" class="paid-library" aria-hidden="true"><div class="bone-library-heading">ダウンロード資料</div><p class="library-note">必要な資料を選んで個別に開けます。</p><div class="pdf-list">
    <% bone_files.each do |path| %><% filename=File.basename(path) %><% number=filename[/\d+/].to_i %>
      <a href="https://physio-app-4ahv.onrender.com/pdfs/bone/<%= filename %>" class="pdf-item pdf-open-link"><div class="pdf-item-left"><div class="pdf-icon">📄</div><span class="pdf-name">骨 資料 <%= format('%03d',number) %></span></div><span class="pdf-download">開く ›</span></a>
    <% end %>
  </div></section>
</div>

<script type="module">
  const PRODUCT_ID="bone_pdf",button=document.getElementById("bone-purchase-button"),status=document.getElementById("bone-purchase-status"),library=document.getElementById("bone-paid-library");
  const setStatus=m=>{if(status)status.textContent=m};
  const unlockLibrary=(m="この資料は購入済みです。")=>{library?.classList.add("is-unlocked");library?.setAttribute("aria-hidden","false");if(button){button.textContent="購入済み｜資料一覧を見る";button.disabled=false;button.onclick=()=>library?.scrollIntoView({behavior:"smooth",block:"start"})}setStatus(m)};

  document.querySelectorAll(".pdf-open-link").forEach(link=>link.addEventListener("click",async e=>{
    const url=link.href;
    const Browser=window.Capacitor?.Plugins?.Browser;
    if(Browser){e.preventDefault();try{await Browser.open({url});}catch(error){console.error("PDF open failed",error);window.location.href=url;}}
  }));

  async function getNativePurchases(){const NativePurchases=window.Capacitor?.Plugins?.NativePurchases||window.Capacitor?.Plugins?.NativePurchasesPlugin;if(!NativePurchases)throw new Error("NativePurchases plugin is unavailable");return{NativePurchases,PURCHASE_TYPE:{INAPP:"inapp"}}}
  async function hasPurchased(NativePurchases,PURCHASE_TYPE){const{purchases=[]}=await NativePurchases.getPurchases({productType:PURCHASE_TYPE.INAPP});return purchases.some(p=>{const same=p.productIdentifier===PRODUCT_ID||p.productId===PRODUCT_ID;const state=p.purchaseState==null||["PURCHASED","1",1].includes(p.purchaseState);return same&&state})}
  async function initializePurchase(){if(!button)return;try{const{NativePurchases,PURCHASE_TYPE}=await getNativePurchases();const{isBillingSupported}=await NativePurchases.isBillingSupported();if(!isBillingSupported){button.textContent="購入はアプリ版で利用できます";button.disabled=true;return}if(await hasPurchased(NativePurchases,PURCHASE_TYPE)){unlockLibrary();return}const{products=[]}=await NativePurchases.getProducts({productIdentifiers:[PRODUCT_ID],productType:PURCHASE_TYPE.INAPP});const product=products.find(i=>i.identifier===PRODUCT_ID||i.productIdentifier===PRODUCT_ID||i.productId===PRODUCT_ID)||products[0];button.textContent=product?.priceString?`${product.priceString}で購入`:"購入する";button.onclick=async()=>{button.disabled=true;const originalText=button.textContent;button.textContent="購入処理中…";setStatus("");try{await NativePurchases.purchaseProduct({productIdentifier:PRODUCT_ID,productType:PURCHASE_TYPE.INAPP,quantity:1,isConsumable:false});if(await hasPurchased(NativePurchases,PURCHASE_TYPE))unlockLibrary("購入が完了しました。資料一覧をご利用いただけます。");else{button.textContent=originalText;button.disabled=false;setStatus("購入状態を確認できませんでした。もう一度お試しください。")}}catch(error){console.error("Purchase failed:",error);button.textContent=originalText;button.disabled=false;setStatus("購入が完了しませんでした。")}}}catch(error){console.error("Native purchases unavailable:",error);button.textContent="購入はアプリ版で利用できます";button.disabled=true;setStatus("")}}
  initializePurchase();
</script>
