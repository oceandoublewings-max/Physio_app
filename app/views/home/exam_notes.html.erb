<style>
  body { margin: 0; background: #f5f8fc; color: #102b4d; }
  .exam-notes, .exam-notes * { box-sizing: border-box; }
  .exam-notes { width: min(92%, 520px); margin: 0 auto; padding: 22px 0 40px; }
  .en-hero { position: relative; overflow: hidden; padding: 22px; border-radius: 0 0 28px 28px; background: radial-gradient(circle at 88% 18%, rgba(255,255,255,.13), transparent 40%), linear-gradient(135deg,#082548,#174f82); box-shadow: 0 10px 26px rgba(9,40,77,.14); color: #fff; }
  .en-top-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .en-label { margin: 0; font-size: 10px; letter-spacing: .12em; color: #c5d4e4; }
  .en-top { flex-shrink: 0; border: 1px solid #bfa65e; border-radius: 24px; padding: 7px 12px; color: #f0d58c; text-decoration: none; font-size: 12px; }
  .en-hero h1 { margin: 22px 0 8px; font-family: "Yu Mincho", "Hiragino Mincho ProN", serif; font-size: clamp(23px,6vw,30px); }
  .en-hero p.en-context { margin: 0; color: #f0d58c; font-size: 13px; line-height: 1.7; }
  .en-heading { text-align: center; font-family: "Yu Mincho", "Hiragino Mincho ProN", serif; font-size: 21px; margin: 26px 0 16px; }
  .en-sample { margin-top: 22px; padding: 18px; border: 1px solid #e7d9b4; border-radius: 18px; background: linear-gradient(120deg,#fffdf6,#f8faff); }
  .en-sample h2 { margin: 0 0 8px; font-size: 18px; }
  .en-description { color: #63748a; font-size: 13px; line-height: 1.8; margin: 6px 0 14px; }
  .en-disabled { display: block; width: 100%; padding: 12px; border: 1px solid #d8dfe8; border-radius: 11px; color: #627085; background: #edf1f6; font: inherit; font-size: 14px; font-weight: 700; cursor: default; opacity: 1; -webkit-text-fill-color: #627085; }
  .en-cards { display: flex; flex-direction: column; gap: 14px; }
  .en-card { position: relative; display: flex; align-items: center; gap: 14px; overflow: hidden; padding: 19px 18px; border: 1px solid #e3e9f0; border-radius: 18px; background: #fff; box-shadow: 0 6px 18px rgba(20,52,88,.07); color: #102b4d; text-decoration: none; }
  .en-card::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: linear-gradient(90deg,#b58a27,#f1d985,#b58a27); }
  .en-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 48px; width: 48px; height: 48px; border-radius: 50%; color: #15375e; background: linear-gradient(145deg,#fff7d8,#ecd084); font-size: 19px; font-weight: 700; }
  .en-card-text { flex: 1; min-width: 0; }
  .en-card-title { display: block; font-size: 20px; font-weight: 700; }
  .en-card-note { display: block; margin-top: 5px; color: #63748a; font-size: 12px; line-height: 1.6; }
  .en-arrow { color: #ae8830; font-size: 25px; }
  .en-product { display: block; }
  .en-product h3 { margin: 0 0 8px; font-size: 21px; }
  .en-back { display: inline-block; margin-top: 25px; padding: 10px 0; color: #173b65; font-size: 14px; }
  .exam-notes a:focus-visible { outline: 3px solid #2677c4; outline-offset: 4px; }
  @media (max-width: 360px) { .en-hero { padding: 18px 15px; } .en-label { font-size: 8px; } .en-card { padding: 17px 14px; } }
</style>

<main class="exam-notes">
  <header class="en-hero">
    <div class="en-top-row">
      <p class="en-label">PT・OT NATIONAL EXAM PREP</p>
      <a class="en-top" href="<%= home_path %>">← TOP</a>
    </div>
    <h1>📖 国試解説ノート</h1>
    <p class="en-context">
      <% if @profession.empty? %>
        図解と解説で、国試のポイントを学ぶ
      <% else %>
        <%= @profession_label %><%= " ／ 第#{@exam_number}回" unless @exam_number.empty? %>
      <% end %>
    </p>
  </header>

  <% if @profession.empty? %>
    <section class="en-sample" aria-labelledby="en-sample-title">
      <h2 id="en-sample-title">無料サンプル</h2>
      <p class="en-description">第60回の問題を使ったサンプルで、<br>解説ノートの内容をご紹介します。</p>
      <a href="/pdfs/exam_notes/60/exam_notes_sample.pdf" style="display:block;margin-top:10px;padding:14px;border:1px solid #d8c58f;border-radius:12px;background:#fff;color:#102b4d;text-align:center;text-decoration:none;font-size:14px;font-weight:700;" onclick="if(window.Capacitor?.Plugins?.Browser){event.preventDefault();window.Capacitor.Plugins.Browser.open({url:this.href}).catch(()=>{window.location.href=this.href;});}">📖 解説・○×付きサンプル</a>
<a href="/pdfs/exam_notes/60/exam_notes_sample_workbook.pdf" style="display:block;margin-top:10px;padding:14px;border:1px solid #d8c58f;border-radius:12px;background:#fff;color:#102b4d;text-align:center;text-decoration:none;font-size:14px;font-weight:700;" onclick="if(window.Capacitor?.Plugins?.Browser){event.preventDefault();window.Capacitor.Plugins.Browser.open({url:this.href}).catch(()=>{window.location.href=this.href;});}">✏️ 空欄版サンプル</a>
    </section>

    <h2 class="en-heading en-profession-heading">資格を選んでください</h2>
    <div class="en-cards">
      <% { "pt" => "理学療法士", "ot" => "作業療法士" }.each do |profession, label| %>
        <a class="en-card" href="<%= exam_notes_path(profession: profession) %>">
          <span class="en-icon" aria-hidden="true"><%= profession.upcase %></span>
          <span class="en-card-text"><span class="en-card-title"><%= profession.upcase %>の解説ノート</span><span class="en-card-note"><%= label %>国家試験</span></span>
          <span class="en-arrow" aria-hidden="true">›</span>
        </a>
      <% end %>
    </div>

    <aside id="en-usage-notice" aria-label="ご利用にあたって"
      style="margin-top:16px;color:#63748a;">
      <p style="margin:0 0 6px;">※ 国家試験の問題は、ご自身でご用意ください。</p>
      <p style="margin:0;">※ 同じ問題でも、PT版・OT版で解説のイラストやまとめ方が異なる場合があります。</p>
    </aside>
    <a class="en-back" href="<%= home_path %>">← ホームに戻る</a>
  <% elsif @exam_number.empty? %>
    <h2 class="en-heading">回数を選んでください</h2>
    <div class="en-cards">
      <a class="en-card" href="<%= exam_notes_path(profession: @profession, exam: "60") %>">
        <span class="en-icon" aria-hidden="true">📘</span>
        <span class="en-card-text"><span class="en-card-title">第60回</span><span class="en-card-note">午前・午後｜解説版＋空欄版のセット</span></span>
        <span class="en-arrow" aria-hidden="true">›</span>
      </a>
    </div>
    <a class="en-back" href="<%= exam_notes_path %>">← サンプル・PT／OT選択に戻る</a>
  <% else %>
    <h2 class="en-heading">午前・午後を選択</h2>
    <div class="en-cards">

      <% { "am" => "午前", "pm" => "午後" }.each do |code, period| %>
        <% product_id = "#{@profession}#{@exam_number}_#{code}_notes" %>
        <% file_prefix = "#{@profession}#{@exam_number}_#{code}" %>
        <section class="en-card en-product"
                 data-exam-product="<%= product_id %>">
          <h3><%= period %></h3>
          <p class="en-description">
            <%= @profession.upcase %> 第<%= @exam_number %>回
            <%= period %>の解説ノート<br>
            解説版＋書き込み式の空欄版PDFのセットです。
          </p>
          <button type="button" class="en-buy" disabled>
            購入情報を確認中…
          </button>
          <button type="button" class="en-restore" disabled>
            購入を復元
          </button>
          <p class="en-status" role="status" aria-live="polite"></p>
          <div class="en-files" hidden>
            <a href="/pdfs/exam_notes/<%= @exam_number %>/<%= file_prefix %>_notes.pdf">
              📖 解説版を開く
            </a>
            <a href="/pdfs/exam_notes/<%= @exam_number %>/<%= file_prefix %>_workbook.pdf">
              ✏️ 空欄版を開く
            </a>
          </div>
        </section>
      <% end %>
    </div>
    <a class="en-back" href="<%= exam_notes_path(profession: @profession) %>">← 回数選択に戻る</a>
  <% end %>
  <footer aria-label="教材の著作権・ご利用について" style="margin-top:24px;padding-top:16px;border-top:1px solid #dce3eb;color:#52677f;">
    <p style="margin:0 0 8px;font-size:12px !important;font-weight:400 !important;line-height:1.8 !important;text-align:left !important;">本教材の無断転載・複製・再配布・販売を禁止します。<br>ご購入者本人の学習目的での閲覧・印刷に限りご利用ください。</p>
    <p style="margin:0;font-size:12px !important;font-weight:400 !important;line-height:1.8 !important;text-align:center !important;">© bonebuddystudio</p>
  </footer>
</main>

<style>
  .exam-notes .en-buy,
  .exam-notes .en-restore {
    width: 100%;
    min-height: 48px;
    padding: 12px;
    border-radius: 12px;
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
  }
  .exam-notes .en-buy {
    border: 1px solid #b99a46;
    background: #ecd084;
    color: #102b4d;
  }
  .exam-notes .en-restore {
    margin-top: 9px;
    border: 1px solid #b9c8da;
    background: #fff;
    color: #173b65;
  }
  .exam-notes button:disabled {
    opacity: .6;
    cursor: default;
  }
  .exam-notes .en-status {
    font-size: 12px;
    line-height: 1.7;
    color: #52677f;
  }
  .exam-notes .en-files[hidden] { display: none; }
  .exam-notes .en-files a {
    display: block;
    margin-top: 10px;
    padding: 14px;
    border: 1px solid #d9e3ef;
    border-radius: 10px;
    background: #f4f8fd;
    color: #173b65;
    text-decoration: none;
    font-weight: 700;
  }
</style>

<script>
(() => {
  function initializeExamNotes() {
    const cards = Array.from(
      document.querySelectorAll("[data-exam-product]")
    );
    if (!cards.length || cards[0].dataset.initialized) return;

    const entries = cards.map(card => {
      card.dataset.initialized = "true";
      return {
        id: card.dataset.examProduct,
        buy: card.querySelector(".en-buy"),
        restore: card.querySelector(".en-restore"),
        status: card.querySelector(".en-status"),
        files: card.querySelector(".en-files"),
        product: null,
        owned: false
      };
    });

    const capacitor = window.Capacitor;
    const platform = capacitor?.getPlatform?.();
    const purchases = capacitor?.Plugins?.NativePurchases ||
                      capacitor?.Plugins?.NativePurchasesPlugin;
    let busy = false;

    function render() {
      entries.forEach(entry => {
        entry.files.hidden = !entry.owned;
        entry.buy.disabled = busy || (!entry.owned && !entry.product);
        entry.restore.disabled = busy;
        entry.buy.textContent = entry.owned
          ? "購入済み｜資料を見る"
          : entry.product
            ? `${entry.product.priceString}で購入（買い切り）`
            : "商品情報を取得できません";
      });
    }

    async function refreshPurchases() {
      const result = await purchases.getPurchases({ onlyCurrentEntitlements: platform === "ios",
        productType: "inapp"
      });
      if (!Array.isArray(result.purchases)) {
        throw new Error("Invalid purchase response");
      }
      entries.forEach(entry => {
        entry.owned = result.purchases.some(purchase =>
          purchase.productIdentifier === entry.id &&
          (platform === "ios" || String(purchase.purchaseState) === "1")
        );
      });
    }

    entries.forEach(entry => {
      entry.files.querySelectorAll("a").forEach(link => {
        link.addEventListener("click", async event => {
          const browser = capacitor?.Plugins?.Browser;
          if (!browser) return;
          event.preventDefault();
          try {
            await browser.open({ url: link.href });
          } catch {
            window.location.assign(link.href);
          }
        });
      });
    });

    if (!["android", "ios"].includes(platform) || !purchases) {
      entries.forEach(entry => {
        entry.buy.textContent = platform === "ios"
          ? "購入機能を読み込めませんでした。アプリを更新してください"
          : "購入はiPhone・Androidアプリ版で利用できます";
        entry.restore.disabled = true;
      });
      return;
    }

    entries.forEach(entry => {
      entry.buy.addEventListener("click", async () => {
        if (busy) return;
        if (entry.owned) {
          entry.files.scrollIntoView({
            behavior: "smooth", block: "center"
          });
          return;
        }
        if (!entry.product) return;

        busy = true;
        render();
        entry.buy.textContent = "購入処理中…";
        entry.status.textContent = "";

        try {
          await purchases.purchaseProduct({
            productIdentifier: entry.id,
            productType: "inapp",
            quantity: 1,
            isConsumable: false,
            autoAcknowledgePurchases: true
          });
          await refreshPurchases();
          entry.status.textContent = entry.owned
            ? "購入を確認しました。下のPDFを開けます。"
            : "購入完了をまだ確認できません。支払い完了後に「購入を復元」を押してください。";
        } catch {
          entry.status.textContent =
            "購入完了を確認できませんでした。支払い済みの場合は「購入を復元」を押してください。";
        } finally {
          busy = false;
          render();
        }
      });

      entry.restore.addEventListener("click", async () => {
        if (busy) return;
        busy = true;
        render();
        entry.status.textContent = "購入情報を確認しています…";

        try {
          await purchases.restorePurchases();
          await refreshPurchases();
          entry.status.textContent = entry.owned
            ? "購入情報を復元しました。下のPDFを開けます。"
            : "この商品の購入情報が見つかりませんでした。購入時のストアアカウントを確認してください。";
        } catch {
          entry.status.textContent =
            "購入情報を確認できませんでした。通信状態を確認して再度お試しください。";
        } finally {
          busy = false;
          render();
        }
      });
    });

    async function load() {
      try {
        const support = await purchases.isBillingSupported();
        if (!support.isBillingSupported) {
          entries.forEach(entry => {
            entry.buy.textContent = "この端末では購入を利用できません";
          });
          return;
        }

        try {
          await refreshPurchases();
        } catch {
          entries.forEach(entry => {
            entry.status.textContent =
              "購入済みの場合は「購入を復元」を押してください。";
          });
        }

        try {
          const result = await purchases.getProducts({
            productIdentifiers: entries.map(entry => entry.id),
            productType: "inapp"
          });
          entries.forEach(entry => {
            entry.product = (result.products || []).find(product =>
              product.identifier === entry.id && product.priceString
            ) || null;
          });
        } catch {
          entries.forEach(entry => {
            entry.status.textContent =
              "価格を取得できませんでした。時間をおいて画面を開き直してください。";
          });
        }
        render();
      } catch {
        entries.forEach(entry => {
          entry.buy.textContent = "購入機能を読み込めませんでした";
          entry.status.textContent = "アプリを開き直してください。";
        });
      }
    }
    load();
  }

  document.addEventListener("turbo:load", initializeExamNotes);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeExamNotes);
  } else {
    initializeExamNotes();
  }

  document.addEventListener("turbo:before-cache", () => {
    document.querySelectorAll("[data-exam-product]").forEach(card => {
      delete card.dataset.initialized;
      card.querySelector(".en-files").hidden = true;
      card.querySelector(".en-status").textContent = "";
      const button = card.querySelector(".en-buy");
      button.disabled = true;
      button.textContent = "購入情報を確認中…";
      card.querySelector(".en-restore").disabled = true;
      card.replaceWith(card.cloneNode(true));
    });
  });
})();
</script>

<style>
/* exam-notes-notice-size */
.exam-notes #en-usage-notice p {
  font-size: 12px !important;
  font-weight: 400 !important;
  line-height: 1.7 !important;
  text-align: left !important;
}
</style>

<style>
/* compact-profession-cards */
.exam-notes .en-profession-heading {
  font-size: 18px;
  margin: 18px 0 10px;
}
.exam-notes .en-profession-heading + .en-cards {
  gap: 10px;
}
.exam-notes .en-profession-heading + .en-cards .en-card {
  padding: 12px 14px;
  gap: 10px;
  border-radius: 14px;
}
.exam-notes .en-profession-heading + .en-cards .en-icon {
  flex: 0 0 38px;
  width: 38px;
  height: 38px;
  font-size: 16px;
}
.exam-notes .en-profession-heading + .en-cards .en-card-title {
  font-size: 17px;
}
.exam-notes .en-profession-heading + .en-cards .en-card-note {
  margin-top: 3px;
  font-size: 11px;
}
</style>
